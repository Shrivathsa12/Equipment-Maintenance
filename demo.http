Authorization: Basic technician@company.com:pqr
Content-Type: application/json

{
  "WorkOrderID": "{{pm1.response.body.$.ID}}",
  "closureCode": "Adjusted",
  "completionRemarks": "Monthly service completed"
}


### 8.15 Manager closes the preventive order
# Expected: 200
# Role: Maintenance Manager (MaintenanceManager)
# Login: manager@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/closeOrder
Authorization: Basic manager@company.com:xyz
Content-Type: application/json

{
  "WorkOrderID": "{{pm1.response.body.$.ID}}"
}


### 8.16 The plan now has a new next due date
# Expected: 200
# Check: lastMaintenanceDate is updated and nextDueDate = last maintenance date + 30 days.
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
GET http://localhost:4004/odata/v4/equipment-maintenance/MaintenancePlans({{planCal.response.body.$.ID}})
Authorization: Basic planner@company.com:lmn



