###
# =====================================================================
# 2. BREAKDOWN REQUESTS (production user)
# Step 2 of the process: a production user reports a breakdown with symptom, impact and photos. Priority is calculated automatically.
# =====================================================================


### 2.1 Photo is mandatory
# Expected: reject
# Role: Production User (ProductionUser)
# Login: productionUser@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/reportBreakdown
Authorization: Basic productionUser@company.com:abc
Content-Type: application/json

{
  "equipment": "{{press.response.body.$.ID}}",
  "symptom": "No photo",
  "description": "Problem seen during production.",
  "requestedPriority": "High",
  "safetyImpact": "High",
  "productionImpact": "High",
  "category": "Mechanical",
  "reportedBy": "anyone",
  "photos": []
}


### 2.2 Unsupported photo format is rejected
# Expected: reject
# Role: Production User (ProductionUser)
# Login: productionUser@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/reportBreakdown
Authorization: Basic productionUser@company.com:abc
Content-Type: application/json

{
  "equipment": "{{press.response.body.$.ID}}",
  "symptom": "Bad photo",
  "description": "Problem seen during production.",
  "requestedPriority": "High",
  "safetyImpact": "High",
  "productionImpact": "High",
  "category": "Mechanical",
  "reportedBy": "anyone",
  "photos": [
    {
      "fileName": "a.pdf",
      "mimeType": "application/pdf",
      "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=="
    }
  ]
}


