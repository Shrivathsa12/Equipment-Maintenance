### 2.7 Production user sees only their own requests
# Expected: 200
# Role: Production User (ProductionUser)
# Login: productionUser@company.com
GET http://localhost:4004/odata/v4/equipment-maintenance/MaintenanceRequests
Authorization: Basic productionUser@company.com:abc


### 2.8 Photo is stored as a document linked to the request
# Expected: 200
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
GET http://localhost:4004/odata/v4/equipment-maintenance/MaintenanceDocuments?$select=ID,fileName,mimeType,fileSize,documentType,maintenanceRequest_ID
Authorization: Basic planner@company.com:lmn



###
# =====================================================================
# 3. PLANNER REVIEWS AND CONVERTS (planner)
# Steps 3 to 5: the planner reviews the request, converts it to a work order with operations and planned dates.
# =====================================================================


### 3.1 Planner marks the request under review
# Expected: 200
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
PATCH http://localhost:4004/odata/v4/equipment-maintenance/MaintenanceRequests({{req1.response.body.$.ID}})
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "status": "UnderReview"
}


### 3.2 Production user cannot convert
# Expected: 403
# Role: Production User (ProductionUser)
# Login: productionUser@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/convertToWorkOrder
Authorization: Basic productionUser@company.com:abc
Content-Type: application/json

{
  "RequestID": "{{req1.response.body.$.ID}}",
  "orderType": "Breakdown",
  "category": "Mechanical",
  "plannedStartDate": "2026-12-01T08:00:00Z",
  "plannedEndDate": "2026-12-01T17:00:00Z",
  "operations": [
    {
      "operationName": "Inspect pump",
      "plannedHours": 2,
      "isMandatory": true
    }
  ]
}


### 3.3 At least one operation is required
# Expected: reject
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/convertToWorkOrder
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "RequestID": "{{req1.response.body.$.ID}}",
  "orderType": "Breakdown",
  "category": "Mechanical",
  "plannedStartDate": "2026-12-01T08:00:00Z",
  "plannedEndDate": "2026-12-01T17:00:00Z",
  "operations": []
}


### 3.4 End date must be after start date
# Expected: reject
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/convertToWorkOrder
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "RequestID": "{{req1.response.body.$.ID}}",
  "orderType": "Breakdown",
  "category": "Mechanical",
  "plannedStartDate": "2026-12-01T08:00:00Z",
  "plannedEndDate": "2026-11-30T08:00:00Z",
  "operations": [
    {
      "operationName": "Inspect pump",
      "plannedHours": 2,
      "isMandatory": true
    }
  ]
}


### 3.5 Planned hours must be greater than zero
# Expected: reject
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/convertToWorkOrder
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "RequestID": "{{req1.response.body.$.ID}}",
  "orderType": "Breakdown",
  "category": "Mechanical",
  "plannedStartDate": "2026-12-01T08:00:00Z",
  "plannedEndDate": "2026-12-01T17:00:00Z",
  "operations": [
    {
      "operationName": "Inspect pump",
      "plannedHours": 0,
      "isMandatory": true
    }
  ]
}


### 3.6 Convert request 1 into a BREAKDOWN work order (two mandatory operations)
# @name wo1
# Expected: 200
# Check: status = Planned, priority = Critical (copied from the request). A downtime event is also opened for a breakdown order.
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/convertToWorkOrder
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "RequestID": "{{req1.response.body.$.ID}}",
  "orderType": "Breakdown",
  "category": "Mechanical",
  "plannedStartDate": "2026-12-01T08:00:00Z",
  "plannedEndDate": "2026-12-01T17:00:00Z",
  "operations": [
    {
      "operationName": "Inspect hydraulic pump",
      "plannedHours": 2,
      "isMandatory": true
    },
    {
      "operationName": "Replace seal and test pressure",
      "plannedHours": 3,
      "isMandatory": true
    }
  ]
}


### 3.7 The same request cannot be converted twice
# Expected: reject
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/convertToWorkOrder
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "RequestID": "{{req1.response.body.$.ID}}",
  "orderType": "Breakdown",
  "category": "Mechanical",
  "plannedStartDate": "2026-12-01T08:00:00Z",
  "plannedEndDate": "2026-12-01T17:00:00Z",
  "operations": [
    {
      "operationName": "Again",
      "plannedHours": 1,
      "isMandatory": true
    }
  ]
}


### 3.8 Operations of work order 1 (in sequence)
# @name ops1
# Expected: 200
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
GET http://localhost:4004/odata/v4/equipment-maintenance/WorkOrders({{wo1.response.body.$.ID}})/operations?$orderby=sequenceNumber
Authorization: Basic planner@company.com:lmn


### 3.9 Downtime event opened by the breakdown order
# Expected: 200
# Role: Maintenance Manager (MaintenanceManager)
# Login: manager@company.com
GET http://localhost:4004/odata/v4/equipment-maintenance/DowntimeEvents?$filter=workOrder_ID eq {{wo1.response.body.$.ID}}
Authorization: Basic manager@company.com:xyz



###
# =====================================================================
# 4. ASSIGN AND RELEASE (planner)
# Steps 6 and 7: assign technicians, then release the order for execution.
# =====================================================================


### 4.1 Cannot release before a technician is assigned
# Expected: reject
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/releaseOrder
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "WorkOrderID": "{{wo1.response.body.$.ID}}"
}


### 4.2 Inactive technician cannot be assigned
# Expected: reject
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/assignTechnician
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "WorkOrderID": "{{wo1.response.body.$.ID}}",
  "TechnicianID": "{{techOff.response.body.$.ID}}",
  "isLead": false
}


### 4.3 Technician cannot assign technicians
# Expected: 403
# Role: Technician (Technician)
# Login: technician@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/assignTechnician
Authorization: Basic technician@company.com:pqr
Content-Type: application/json

{
  "WorkOrderID": "{{wo1.response.body.$.ID}}",
  "TechnicianID": "{{tech.response.body.$.ID}}",
  "isLead": true
