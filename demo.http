# =====================================================================
# Equipment Maintenance and Work Order Management - business flow tests
#
# HOW TO RUN
# 1. Start the server with an empty database (restart cds watch).
# 2. Click "Send Request" on every request from top to bottom, in order.
#    Records created by one request are used by the next one automatically.
# 3. "Expected" is the correct result:
#      200 / 201  success
#      401        not logged in
#      403        role not allowed
#      reject     a business rule rejects it (HTTP 400, 404, 409 or 500, with a message)
#
# AUTHENTICATION (mocked users from package.json)
#   Production User        productionUser@company.com   abc
#   Maintenance Planner    planner@company.com          lmn
#   Technician             technician@company.com       pqr
#   Maintenance Manager    manager@company.com          xyz
# Each request sends:  Authorization: Basic <email>:<password>
# =====================================================================



###
# =====================================================================
# 0. AUTHENTICATION
# Every request sends HTTP Basic authentication. No login = 401, wrong password = 401, wrong role = 403.
# =====================================================================


### 0.1 No login
# Expected: 401
# Check: With the dev user switcher (server.js) loaded this returns 200 because the request runs as the production user.
GET http://localhost:4004/odata/v4/equipment-maintenance/Equipment


### 0.2 Wrong password
# Expected: 401
# Role: Wrong password
# Login: planner@company.com
GET http://localhost:4004/odata/v4/equipment-maintenance/Equipment
Authorization: Basic planner@company.com:wrong


### 0.3 Logged-in users can read equipment
# Expected: 200
# Role: Production User (ProductionUser)
# Login: productionUser@company.com
GET http://localhost:4004/odata/v4/equipment-maintenance/Equipment
Authorization: Basic productionUser@company.com:abc



###
# =====================================================================
# 1. MASTER DATA (planner)
# Step 1 of the business process: register equipment with location, hierarchy and criticality; set up technicians, spare parts and maintenance plans.
# =====================================================================


### 1.1 Production user cannot create master data
# Expected: 403
# Role: Production User (ProductionUser)
# Login: productionUser@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/EquipmentLocations
Authorization: Basic productionUser@company.com:abc
Content-Type: application/json

{
  "locationCode": "LOC-01",
  "locationName": "Main Plant"
}


### 1.2 Create location
# @name loc
# Expected: 201
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/EquipmentLocations
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "locationCode": "LOC-01",
  "locationName": "Main Plant"
}


### 1.3 Create sub-location (location hierarchy)
# @name loc2
# Expected: 201
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/EquipmentLocations
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "locationCode": "LOC-01-A",
  "locationName": "Press Hall",
  "parentLocation_ID": "{{loc.response.body.$.ID}}"
}


### 1.4 Create parent equipment (production line)
# @name line
# Expected: 201
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/Equipment
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "equipmentCode": "LINE-01",
  "equipmentName": "Production Line 1",
  "criticality": "Medium",
  "meterUnit": "Hours",
  "currentReading": 500,
  "location_ID": "{{loc.response.body.$.ID}}"
}


### 1.5 Create critical equipment under the line (equipment hierarchy, warranty)
# @name press
# Expected: 201
# Role: Maintenance Planner (MaintenancePlanner)
# Login: planner@company.com
POST http://localhost:4004/odata/v4/equipment-maintenance/Equipment
Authorization: Basic planner@company.com:lmn
Content-Type: application/json

{
  "equipmentCode": "EQ-PRESS",
  "equipmentName": "Hydraulic Press",
  "description": "Main hydraulic press",
  "manufacturer": "Bosch Rexroth",
  "serialNumber": "HYD-001",
  "criticality": "Critical",
  "warrantyEndDate": "2027-12-31",
  "meterUnit": "Hours",
  "currentReading": 1600,
  "location_ID": "{{loc2.response.body.$.ID}}",
  "parentEquipment_ID": "{{line.response.body.$.ID}}"
}


