### 5. reportBreakdown - report the breakdown with a photo
POST http://localhost:4004/odata/v4/equipment-maintenance/reportBreakdown
Authorization: Basic productionUser@company.com:abc
Content-Type: application/json

{
  "equipment": "78693ca5-58c6-4493-9648-1f7cd4f900a8",
  "symptom": "Press stopped suddenly",
  "description": "Hydraulic press stopped during production and is leaking oil",
  "requestedPriority": "Critical",
  "safetyImpact": "Medium",
  "productionImpact": "High",
  "category": "Mechanical",
  "reportedBy": "productionUser@company.com",
  "photos": [
    {
      "fileName": "leak.png",
      "mimeType": "image/png",
      "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=="
    }
  ]
}

